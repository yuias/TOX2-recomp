{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "clang-ninja",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "clang-ninja",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "profile",
      "inherits": "clang-ninja",
      "displayName": "Profile (Release code with line tables and PDBs)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-gline-tables-only -gcodeview",
        "CMAKE_CXX_FLAGS": "-gline-tables-only -gcodeview",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,/DEBUG",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,/DEBUG"
      }
    },
    {
      "name": "release-wwoff",
      "inherits": "release",
      "displayName": "Release, RSX write watch off",
      "cacheVariables": { "TOX2_RSX_WRITE_WATCH": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "release-wwoff", "configurePreset": "release-wwoff" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "profile", "configurePreset": "profile", "output": { "outputOnFailure": true } },
    { "name": "release-wwoff", "configurePreset": "release-wwoff", "output": { "outputOnFailure": true } }
  ]
}
